{
  "name": "intent-flow",
  "displayName": "IntentFlow",
  "description": "Comment-Driven Development Framework - 注释驱动开发框架",
  "version": "0.5.0",
  "publisher": "TheChengXi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheChengXi/intent-flow.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "bin": {
    "iflow": "./dist/cli/iflow.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "iflow.checkFileSize",
        "title": "IntentFlow: 扫描项目大文件"
      },
      {
        "command": "iflow.checkCurrentFileWithDeps",
        "title": "IntentFlow: 检查当前文件及依赖大小"
      },
      {
        "command": "iflow.toggleDryRun",
        "title": "IntentFlow: Toggle Dry Run Mode"
      },
      {
        "command": "iflow.openCapabilityMap",
        "title": "IntentFlow: 打开能力地图"
      },
      {
        "command": "iflow.toggleSelectionMode",
        "title": "IntentFlow: 切换框选模式"
      },
      {
        "command": "iflow.clearSelection",
        "title": "IntentFlow: 清除选中"
      },
      {
        "command": "iflow.projectIntents",
        "title": "IntentFlow: 重建意图投射目录 (.intentflow/intents/)"
      },
      {
        "command": "iflow.addToIntents",
        "title": "IntentFlow: 添加到此意图目录"
      },
      {
        "command": "iflow.removeFromIntents",
        "title": "IntentFlow: 从意图目录移除"
      }
    ],
    "menus": {
      "editor/context": [],
      "commandPalette": [
        {
          "command": "iflow.checkFileSize"
        },
        {
          "command": "iflow.checkCurrentFileWithDeps"
        },
        {
          "command": "iflow.openCapabilityMap"
        },
        {
          "command": "iflow.projectIntents"
        },
        {
          "command": "iflow.addToIntents"
        },
        {
          "command": "iflow.removeFromIntents"
        }
      ],
      "explorer/context": [
        {
          "command": "iflow.addToIntents",
          "when": "explorerResourceIsFolder",
          "group": "iflow@1"
        },
        {
          "command": "iflow.removeFromIntents",
          "when": "explorerResourceIsFolder",
          "group": "iflow@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "iflow.toggleSelectionMode",
        "key": "b",
        "when": "activeWebviewPanelId == 'iflow.capabilityMap'"
      }
    ],
    "configuration": {
      "title": "IntentFlow",
      "properties": {
        "iflow.intents.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "意图投射的源文件夹列表（相对工作区路径），右键文件夹 → 添加到此意图目录 自动写入"
        },
        "iflow.intents.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/dist/**"
          ],
          "description": "意图投射的排除模式（glob 语法），匹配的文件/目录不会生成投射文件。默认排除 dist"
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/copy-wasm.js",
    "copy-wasm": "node scripts/copy-wasm.js",
    "vscode:prepublish": "npm run package",
    "test:imports": "npx tsx test_multilang_imports.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "precompile": "echo \"[warn] generate-prompts script has been retired\"",
    "compile": "npm run compile:vscode && npm run compile:mcp && npm run compile:cli && npm run compile:pi",
    "watch": "set IFLOW_BUILD=extension && npx vite build --watch",
    "package": "npx vite build && cd src/adapter/vscode/ui/webview && npx vite build --config vite.config.mts",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "mcp": "node dist/mcp-server.js",
    "mcp:dev": "ts-node src/adapter/mcp/MCPServer.ts",
    "verify:mcp": "npm run compile:mcp && node scripts/mcp-stress-test.mjs",
    "compile:vscode": "set IFLOW_BUILD=extension && npx vite build && cd src/adapter/vscode/ui/webview && npx vite build --config vite.config.mts",
    "compile:mcp": "set IFLOW_BUILD=mcp-server && npx vite build",
    "compile:cli": "set IFLOW_BUILD=cli/iflow && npx vite build",
    "compile:pi": "set IFLOW_BUILD=pi/extension && npx vite build",
    "deploy:pi": "node scripts/deploy-pi.js"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.80.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.9",
    "vue": "^3.5.38",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@chenglou/pretext": "^0.0.8",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/resolve": "^1.20.6",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xstate/vue": "^5.0.0",
    "js-yaml": "^4.2.0",
    "leafer-ui": "^2.1.9",
    "minimatch": "^10.2.5",
    "openai": "^6.37.0",
    "resolve": "^1.22.12",
    "typebox": "^1.3.6",
    "xstate": "^5.32.2",
    "zod": "^4.4.3"
  }
}
