{
  "name": "intent-flow",
  "version": "0.7.0",
  "description": "Comment-Driven Development Framework - 注释驱动开发框架",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheChengXi/intent-flow.git"
  },
  "bin": {
    "iflow": "./dist/cli/iflow.js"
  },
  "scripts": {
    "postinstall": "node scripts/copy-wasm.js",
    "copy-wasm": "node scripts/copy-wasm.js",
    "test:imports": "npx tsx test_multilang_imports.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "npm run compile:mcp && npm run compile:cli && npm run compile:pi",
    "mcp": "node dist/mcp-server.js",
    "mcp:dev": "ts-node --files src/adapter/mcp/MCPServer.ts",
    "verify:mcp": "npm run compile:mcp && node scripts/mcp-stress-test.mjs",
    "compile:mcp": "set IFLOW_BUILD=mcp-server && npx vite build",
    "compile:cli": "set IFLOW_BUILD=cli/iflow && npx vite build",
    "compile:pi": "set IFLOW_BUILD=pi/extension && npx vite build",
    "deploy:pi": "node scripts/deploy-pi.js",
    "fetch-release": "node scripts/fetch-release.js"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/resolve": "^1.20.6",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "js-yaml": "^4.2.0",
    "minimatch": "^10.2.5",
    "openai": "^6.37.0",
    "resolve": "^1.22.12",
    "typebox": "^1.3.6",
    "zod": "^4.4.3"
  }
}
